# Practice Core Environment Variables
# Copy this file to .env.local and update with your actual values

# ─────────────────────────────────────────────
# Frontend / Public Variables
# ─────────────────────────────────────────────

# AI Debug UI Toggle
# true = show OpenAI request/raw response debug panels in UI
# false = hide debug/testing panels (recommended for production)
# Optional URL override in browser: ?debug=1 or ?debug=0
NEXT_PUBLIC_SHOW_AI_DEBUG=false

# Domain Mode — Hostname-Based Detection
# The active domain experience is resolved from the browser hostname. Private
# domain mappings are supplied by the overlay; without it, only `default` is available.
#
# To add custom hostname → domain mappings supply a JSON object here.
# Keys are hostnames (exact match or root domain for subdomain matching).
# Values must match a domain mode supplied by the core or private overlay.
#
# NOTE: Because this value contains JSON, wrap the entire value in single quotes
# in shell environments or .env files to avoid quoting/escaping issues.
# Example:
#   NEXT_PUBLIC_HOSTNAME_DOMAIN_MAP='{"portal.example.com":"example-domain","staging.example.com":"example-domain"}'
#
# NEXT_PUBLIC_HOSTNAME_DOMAIN_MAP=

# Private domain overlay (build-time only) — see docs/private-domains.md.
# Hosted builds that must serve customer domains need the overlay mounted. When the
# `src/private` submodule cannot be cloned, the build can clone it itself with a token,
# and PRIVATE_OVERLAY_REQUIRED makes a build without the overlay fail instead of
# silently serving every customer hostname with the default domain's site.
# PRIVATE_OVERLAY_DIR=
# PRIVATE_OVERLAY_REPO_URL=https://github.com/<owner>/<private-overlay-repo>.git
# PRIVATE_OVERLAY_REF=main
# PRIVATE_OVERLAY_TOKEN=
# PRIVATE_OVERLAY_REQUIRED=1

# App version, build identity and build timestamp — injected at build time by next.config.js.
# NEXT_PUBLIC_APP_VERSION is read from package.json, which semantic-release keeps current on
# each release (see docs/developer-guide/versioning.md), so leave these commented out in .env files.
# NEXT_PUBLIC_APP_VERSION=1.0.0
# NEXT_PUBLIC_BUILD_TIME=2024-01-01T00:00:00.000Z

# AGPL-3.0 section 13: where network users can obtain the source of this deployment. Defaults to
# the project repository; point it at your own copy if you distribute a modified version.
# NEXT_PUBLIC_SOURCE_URL=https://github.com/PracticeTI/practice-manager

# Optional: tell the build which commit it is. Only needed where the builder cannot work it out
# itself — Vercel, Cloud Build and GitHub Actions each supply their own variable automatically,
# and a local build falls back to `git rev-parse`. Containers that exclude .git must pass these.
# BUILD_COMMIT_SHA=
# BUILD_COMMIT_REF=
# BUILD_ID=

# Optional: label the deployment environment shown to superadmins ("prod", "staging", ...).
# Set this on Cloud Run, which has no environment concept of its own. Falls back to
# VERCEL_ENV and then NODE_ENV. See the runtime block in /api/auth/setup-status.
# APP_ENV=

# Vercel Blob write token for server-side Hero thumbnail uploads.
# In Vercel, this is normally injected automatically after linking a Blob store.
# For local testing with Blob, add your read-write token here.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ─────────────────────────────────────────────
# File storage
# ─────────────────────────────────────────────
# Uploaded files are kept in PostgreSQL by default. A practice can choose another
# backend in Admin → Settings → Domains → Features → File storage; the bucket,
# directory and credentials stay here so a practice cannot point itself somewhere
# the deployment has no access to. Full behaviour: docs/file-storage.md
#
# Local files — a directory on this host. Mount a volume here in containers.
# Unavailable on serverless hosts, whose filesystem is ephemeral.
# FILE_STORAGE_DIR=/var/lib/practice/files
#
# Optional namespace inside the storage root/bucket (keys become
# <prefix>/domains/<domain>/...). Useful when one bucket holds several deployments.
# FILE_STORAGE_PREFIX=
#
# Amazon S3 or an S3-compatible store. Falls back to AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_REGION and AWS_SESSION_TOKEN when the FILE_STORAGE_*
# names are unset.
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_REGION=
# FILE_STORAGE_S3_ENDPOINT=
# FILE_STORAGE_S3_ACCESS_KEY_ID=
# FILE_STORAGE_S3_SECRET_ACCESS_KEY=
# FILE_STORAGE_S3_SESSION_TOKEN=
# FILE_STORAGE_S3_FORCE_PATH_STYLE=false
#
# Google Cloud Storage. On Cloud Run/GCE the metadata server supplies credentials,
# so only the bucket is needed there.
# FILE_STORAGE_GCS_BUCKET=
# FILE_STORAGE_GCS_SERVICE_ACCOUNT_JSON=
# FILE_STORAGE_GCS_SERVICE_ACCOUNT_PATH=
# FILE_STORAGE_GCS_ACCESS_TOKEN=

# ─────────────────────────────────────────────
# Admin
# ─────────────────────────────────────────────

# Admin Credentials
# Username and password for admin panel access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# Always Show Admin Banner
# When set to true, the admin banner is always displayed (including on admin pages)
# and overrides the per-user toggle preference. The banner is never shown on mobile
# regardless of this setting.
# Prefer the server-side variable (ALWAYS_SHOW_ADMIN_BANNER) over the public one.
# ALWAYS_SHOW_ADMIN_BANNER=true
# NEXT_PUBLIC_ALWAYS_SHOW_ADMIN_BANNER=true

# Optional preview deployment bypass for Vercel
# When enabled, Vercel preview deployments auto-create a local admin session
# so test deployments can open /admin without manual sign-in.
# This is ignored outside Vercel preview environments. It keys on Vercel's `preview`
# environment, so it also covers every branch and pull-request preview deployment.
#
# The bypass session is a domain-scoped admin, never a superadmin: it can only read
# the domain named by ADMIN_PREVIEW_DOMAIN, and row-level security binds that domain.
# Deployment Protection is still the only thing keeping the token off the internet,
# so keep Vercel Authentication enabled on every environment that sets this.
ADMIN_PREVIEW_BYPASS=false
ADMIN_PREVIEW_USERNAME=vercel-preview
# Domain the preview bypass is scoped to. Required whenever ADMIN_PREVIEW_BYPASS is
# true — with it unset the token resolves to no principal and no bypass exists.
# Must be one of the configured domain keys (see src/lib/domainMode.js).
ADMIN_PREVIEW_DOMAIN=

# Deny-by-default gate for the whole /api surface (see src/lib/apiGate.js)
# `enforce` (default) returns 401 to any request without a valid admin token or the
# service secret, unless the path and method are on the public allowlist. `report`
# logs "[api-gate] would deny ..." and lets the request through: use it to find the
# allowlist a new surface needs before turning enforcement on for it. One knob
# governs both this gate and the /api/database one.
API_GATE=enforce

# Which database this deployment expects (see src/lib/databaseEnvironmentGuard.js)
# production | preview | development | test. Leave unset to disable the guard.
# A preview deployment whose database is marked production refuses to serve (503)
# instead of writing to it; set ALLOW_PRODUCTION_DATABASE_IN_PREVIEW=1 for a
# deliberate one-off check against production data.
DATABASE_ENVIRONMENT=

# JWT Secret for Admin Authentication
# Used for signing and verifying admin JWT tokens
# Generate a secure random string for production
JWT_SECRET=your-jwt-secret-key-here

# Calendar Feed Secret (optional)
# Signs the read-only ICS subscription URLs. Falls back to JWT_SECRET when unset.
# Generate a separate secure random string in production.
CALENDAR_FEED_SECRET=

# Scheduling automation — confirmation, reminder and waitlist-offer links
# Signs appointment confirmation and waitlist offer tokens.
# Falls back to CALENDAR_FEED_SECRET, then JWT_SECRET.
SCHEDULING_CONFIRMATION_SECRET=
# Origin used when building confirmation/offer links. Defaults to the request origin.
SCHEDULING_PUBLIC_URL=
# Shared secret for POST /api/scheduling/reminders/run (also accepts CRON_SECRET).
SCHEDULING_REMINDER_RUN_SECRET=
# AES-256-GCM key for the stored external-calendar OAuth tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Either CALENDAR_TOKEN_ENCRYPTION_KEY or SCHEDULING_TOKEN_ENCRYPTION_KEY is required
# before connecting Google Calendar or Microsoft 365.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# ─────────────────────────────────────────────
# AI Providers
# ─────────────────────────────────────────────
# The app is provider-agnostic. Every feature that calls a model goes through
# src/lib/ai/chat.js, which dispatches to OpenAI, Claude, Gemini or DeepSeek
# based on the configuration below (or a domain's AI settings).
#
# Selection order: explicit per-domain setting -> AI_PROVIDER -> OpenAI.
# Model order:     explicit per-domain model -> provider *_MODEL -> AI_MODEL
#                  -> provider default.
#
# You only need the key for the provider you actually use, but setting several
# lets you switch per domain without a redeploy.

# Global defaults (optional).
# AI_PROVIDER=openai            # openai | claude | gemini | deepseek | openrouter
# AI_MODEL=                     # blank = provider default

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
# OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=https://api.openai.com/v1

# Claude (Anthropic) — https://console.anthropic.com/settings/keys
# CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=            # accepted alias for CLAUDE_API_KEY
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Gemini (Google) — https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY= # accepted alias for GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash

# DeepSeek — https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# OpenRouter — https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=minimax/minimax-m3.1-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-service providers (optional)
# --------------------------------
# Chat, web search and transcription are configured separately in
# Admin → Settings → AI services (stored in system_state). These env vars only
# seed the defaults before anything is saved there.
# AI_WEB_SEARCH_PROVIDER=openai    # openai | claude | gemini
# AI_TRANSCRIPTION_PROVIDER=openai # openai | gemini

# ─────────────────────────────────────────────
# AI Assistant (per-domain /admin/assistant)
# ─────────────────────────────────────────────
# The assistant provider is chosen per domain in Domain Settings → AI Assistant.
#   - 'google-vertex' (default): Vertex AI (Gemini) using a Google service account.
#   - 'google':                Gemini Developer API via an API key.
#   - 'openai':                Uses the existing per-domain OpenAI key (OPENAI_API_KEY fallback).
#   - 'claude':                Uses ANTHROPIC_API_KEY / CLAUDE_API_KEY.
#   - 'deepseek':              Uses DEEPSEEK_API_KEY.
#   - 'openrouter':            Uses OPENROUTER_API_KEY.

# Service-account JSON for Vertex AI. Supply the full JSON object on one line.
# The assistant uses the project/location configured per domain in settings.
# On Cloud Run this can instead be omitted to rely on the attached service account (ADC).
# GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...","client_email":"...@....iam.gserviceaccount.com",...}

# Alternative to GCP_SERVICE_ACCOUNT_JSON: a path to a service-account JSON file.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini Developer API key (used when a domain's assistant provider is 'google').
# GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
# GEMINI_API_KEY=your-gemini-api-key

# Claude / DeepSeek / OpenRouter assistant providers reuse their keys from the
# AI Providers section above.

# Asana personal access token for public contact submissions.
# Used by /contact to create tasks in the configured Asana project.
# Create one at: https://app.asana.com/0/my-apps
# ASANA_ACCESS_TOKEN=your-asana-personal-access-token

# ─────────────────────────────────────────────
# External API Keys
# ─────────────────────────────────────────────

# Brave Search API key — used for web/image search fallback
# Get from: https://api.search.brave.com/
# BRAVE_API_KEY=your-brave-api-key-here

# Google OAuth client — used only for Google Calendar busy-time sync.
# Create an OAuth client in Google Cloud (Web application).
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
#
# Domain-scoped overrides (preferred when each domain has separate credentials).
# Name them <UPPER_SNAKE_DOMAIN>_GOOGLE_OAUTH_CLIENT_ID / _SECRET, e.g. for `mybrand`:
# MYBRAND_GOOGLE_OAUTH_CLIENT_ID=your-mybrand-client-id.apps.googleusercontent.com
# MYBRAND_GOOGLE_OAUTH_CLIENT_SECRET=your-mybrand-client-secret

# Google Calendar busy-time sync (external calendar connections)
# Reuses GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET above; the calendar
# connection flow requests the calendar.readonly scope. Register this redirect URI:
# GOOGLE_CALENDAR_REDIRECT_URI=http://mybrand.localhost:3000/api/scheduling/calendar/oauth/google/callback
#
# Microsoft 365 busy-time sync (Graph)
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_TENANT_ID=common
# MICROSOFT_CALENDAR_REDIRECT_URI=http://mybrand.localhost:3000/api/scheduling/calendar/oauth/microsoft/callback

# SMS delivery for appointment reminders and waitlist offers
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_FROM_NUMBER=+61400000000
# Shared secret for POST /api/webhooks/sms/inbound (falls back to CORE_BACKEND_SECRET)
# SMS_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────

# Primary PostgreSQL connection string (standard)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@localhost:5432/practice

# Optional local RLS role assumed inside domain-scoped PostgreSQL transactions.
# Defaults to practice_manager_app outside production. Create it with npm run rls:setup:local.
# Leave unset when DATABASE_URL already uses a constrained hosted runtime role.
# POSTGRES_RLS_RUNTIME_ROLE=practice_manager_app

# Explicit primary URL used by the save-production flow
# Falls back to DATABASE_URL if not set
# DATABASE_URL_PRIMARY=postgresql://username:password@primary-host:5432/practice

# Alternative PostgreSQL URL (e.g. Vercel Postgres / Neon)
# Used interchangeably with DATABASE_URL; whichever is present takes precedence
# POSTGRES_URL=postgresql://username:password@host:5432/practice

# Supabase primary connection string
# Used for sync-status checks; falls back to DATABASE_URL if not set
# SUPABASE_PRIMARY_URL=postgresql://username:password@db.supabase.co:5432/postgres

# MongoDB connection string (optional — enables MongoDB adapter) — ⚠️ DEPRECATED
# MongoDB support is deprecated. Please use PostgreSQL instead.
# This variable is maintained for backward compatibility only.
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/practice

# ─────────────────────────────────────────────
# Service URLs
# ─────────────────────────────────────────────

# Shared secret used to authenticate requests between the core backend and service endpoints.
# Use the same value anywhere signed service-to-service calls are validated.
# PLUGIN_SIGNING_SECRET=your-plugin-signing-secret-here
# CORE_BACKEND_SECRET=your-core-backend-secret-here

# WIT (ingestion tools) authentication secret
# Used for authenticating requests from WIT to the core backend
# Set this in both ONE and WIT .env files (use the same value)
# WIT_API_SECRET=your-wit-api-secret-here

# Host Matrix (Dashboard + Service Targets)
# Domains no longer run in separate containers/servers; keep dashboard on 3000.
# Use serverful URL vars only for Node backend services (email/jobs/webhooks).
DASHBOARD_URL=http://localhost:3000

# Backend services fallback host used when explicit service URLs are unset.
# Dev with containers: http://localhost:3003
# Production: set this host in Vercel/your hosting environment variables.
DOMAIN_BACKEND_URL=http://localhost:3003

# In-process scheduled workers (Solo / Docker / Desktop)
# Set INLINE_WORKERS=true when there is no separate runtime service. The app then
# starts the enabled queue poll loops itself and keeps queue reads/writes local.
# Enable only the workers this practice uses. Inbound email follows
# EMAIL_WORKER_ENABLED unless INBOUND_EMAIL_WORKER_ENABLED is set explicitly.
# INLINE_WORKERS=false
# REPORT_WORKER_ENABLED=false
# SCRIBE_WORKER_ENABLED=false
# ANALYSIS_WORKER_ENABLED=false
# BILLING_WORKER_ENABLED=false
# EMAIL_WORKER_ENABLED=false
# INBOUND_EMAIL_WORKER_ENABLED=false
# EQUIPMENT_SOURCER_WORKER_ENABLED=false
# QUOTE_WRITER_WORKER_ENABLED=false
# SCHEDULING_REMINDER_WORKER_ENABLED=false
# ANALYSIS_BACKFILL_TRIGGER_ENABLED=false
# ENV_HEALTH_WORKER_ENABLED=false

# Optional: one-shot email worker trigger endpoint (for Cloud Run or similar).
# When set, one will call this URL after a successful email queue enqueue.
# Example: https://email-worker-xxxx.a.run.app/api/email/worker/run
# EMAIL_WORKER_TRIGGER_URL=

# Optional bearer token for the one-shot trigger endpoint.
# Falls back to CORE_BACKEND_SECRET when omitted.
# EMAIL_WORKER_TRIGGER_SECRET=

# Optional timeout for the trigger request in milliseconds.
# Keep low so enqueue requests stay responsive in Vercel.
# EMAIL_WORKER_TRIGGER_TIMEOUT_MS=1500

# Optional per-message max attempts override sent to the queue endpoint.
# Helps control when a message is marked failed.
# EMAIL_QUEUE_MAX_ATTEMPTS=8

# Optional retry backoff base (seconds) passed to the one-shot worker trigger payload.
# This has effect when your Cloud Run worker endpoint reads retryBaseSeconds from the POST body.
# EMAIL_RETRY_BASE_SECONDS=180

# Quote Writer worker (patient Quotes tab).
# The worker runs inside the app because every draft line is priced and validated
# against src/lib/ndisSupportCatalogue.js, the single source of truth for NDIS
# price limits. Turn the automatic interval/queue draining on with this flag; the
# inline "Draft with worker" button in the Quotes panel always works.
# QUOTE_WRITER_WORKER_ENABLED=false
# Optional queue/table tuning (defaults shown).
# QUOTE_WRITER_QUEUE_TABLE=patient_quote_jobs
# QUOTE_WRITER_BATCH_SIZE=5
# QUOTE_WRITER_MAX_ATTEMPTS=3
# QUOTE_WRITER_STALE_PROCESSING_MINUTES=10

# NDIS support catalogue, shared with the worker service.
# src/lib/ndisSupportCatalogue.js is the seed. It is published into the
# system_state row `ndis_support_catalogue_v1`, and that row is what the worker
# service reads — so neither app carries a second copy of the price limits.
# Publishing is automatic (every quote operation republishes whenever the stored
# copy stops matching the seed's content hash). To check or force it:
#   GET  /api/database/ndis-catalogue   -> { matchesCode, source, code, published }
#   POST /api/database/ndis-catalogue   -> publish ({"force":true} to rewrite)


# ---------------------------------------------------------------------------
# Private domain overlay
# ---------------------------------------------------------------------------
# Private customer domains live in a separate repository mounted at src/private.
# It declares their mail, branding and metadata values, so most per-domain
# settings need no environment variables. The exceptions are operator-specific:
#
# Public origin used in outbound user agents and generated links.
# NEXT_PUBLIC_SITE_URL=https://example.com
#
# Mailing domain for per-domain sender mailboxes (<domain>.contact@<mailDomain>).
# Falls back to the `mailDomain` declared by the private overlay. Set this only
# to override it.
# FORM_ALERT_EMAIL_DOMAIN=mail.example.com
# SOURCING_EMAIL_DOMAIN=mail.example.com
#
# Domain stamped on an inbound message that arrived with none. Set it to the
# practice that owns the shared inbox; defaults to `default`.
# INBOUND_DEFAULT_DOMAIN=
#
# Where the private platform admin app lives (optional).
# NEXT_PUBLIC_WIT_APP_URL=https://wit.example.com
#
# Comma-separated hosts probed by GET /api/domain-backend/diagnose.
# DOMAIN_BACKEND_COMPARE_HOSTS=worker.example.com
