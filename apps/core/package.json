{
  "name": "@practice-manager/core",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.mjs && node scripts/sync-private-overlay.mjs",
    "dev": "npm run dev:free-port && next dev -p 3000",
    "dev:free-port": "node scripts/free-port.mjs 3000",
    "prebuild": "node scripts/check-node-version.mjs && node scripts/sync-private-overlay.mjs",
    "build": "next build --webpack",
    "postbuild": "node -e \"const fs=require('fs');fs.mkdirSync('.next',{recursive:true});fs.closeSync(fs.openSync('.next/lock','a'));\"",
    "start": "next start",
    "lint": "eslint .",
    "private:sync": "node scripts/sync-private-overlay.mjs",
    "private:clean": "node scripts/sync-private-overlay.mjs --clean",
    "private:check": "node scripts/sync-private-overlay.mjs --check",
    "private:guard": "node scripts/check-private-files.mjs",
    "snapshot:weekly": "./scripts/create-weekly-snapshot.sh",
    "snapshot:weekly:install": "./scripts/install-weekly-snapshot-launchd.sh",
    "snapshot:weekly:status": "./scripts/weekly-snapshot-status.sh",
    "snapshot:weekly:uninstall": "./scripts/uninstall-weekly-snapshot-launchd.sh",
    "backfill:company-logos:dry": "node scripts/backfill-company-logo-image-id.mjs",
    "backfill:company-logos": "node scripts/backfill-company-logo-image-id.mjs --apply",
    "migrate:hero-thumbnails:dry": "node scripts/migrate-hero-thumbnail-storage.mjs",
    "migrate:hero-thumbnails": "node scripts/migrate-hero-thumbnail-storage.mjs --apply",
    "migrate:billing-schema": "node scripts/migrate-billing-table-schema.mjs",
    "migrate:outbound-messages-review": "node --env-file-if-exists=.env.local scripts/migrate-outbound-messages-review-columns.mjs",
    "migrate:notification-settings": "node --env-file-if-exists=.env.local scripts/migrate-admin-notification-settings.mjs",
    "migrate:scheduling:dry": "node --env-file=.env.local scripts/migrate-scheduling-phase0.mjs",
    "migrate:scheduling": "node --env-file=.env.local scripts/migrate-scheduling-phase0.mjs --apply",
    "purge:patient-drive-metadata:dry": "node --env-file-if-exists=.env.local scripts/purge-patient-drive-metadata.mjs",
    "purge:patient-drive-metadata": "node --env-file-if-exists=.env.local scripts/purge-patient-drive-metadata.mjs --apply",
    "rls:setup:local": "node --env-file=.env.local scripts/setup-local-patient-files-rls.mjs",
    "rls:policies:dry": "node scripts/setup-rls-policies.mjs",
    "rls:policies": "node scripts/setup-rls-policies.mjs --apply",
    "rls:verify": "node --env-file=.env.local scripts/rls-verify.mjs",
    "rls:coverage": "node scripts/rls-coverage.mjs",
    "db:prepare": "npm run rls:policies",
    "db:init": "node --env-file-if-exists=.env.local --import ./scripts/alias-hooks.mjs scripts/db-init.mjs",
    "test": "node --import ./scripts/alias-hooks.mjs --test \"test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "test:rls": "node --import ./scripts/alias-hooks.mjs --test test/postgresRlsContext.test.js && node --import ./scripts/alias-hooks.mjs --env-file=.env.local --test test/patientFilesRls.integration.test.js",
    "pretest": "node scripts/sync-private-overlay.mjs"
  },
  "dependencies": {
    "@practice-manager/jobs": "*",
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/google": "^4.0.64",
    "@ai-sdk/google-vertex": "^5.0.76",
    "@ai-sdk/openai": "^4.0.60",
    "@ai-sdk/openai-compatible": "^3.0.44",
    "@assistant-ui/ai-sdk": "^0.0.4",
    "@assistant-ui/react": "^0.15.18",
    "@vercel/blob": "^2.3.3",
    "ai": "^7.0.93",
    "gray-matter": "^4.0.3",
    "html-to-image": "^1.11.13",
    "jose": "^6.1.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.35.0",
    "mammoth": "^1.12.0",
    "mongodb": "^7.0.0",
    "next": "^16.3.3",
    "node-fetch": "^3.3.2",
    "papaparse": "^5.7.0",
    "pg": "^8.17.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "unpdf": "^2.1.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.3",
    "postcss": "^8",
    "tailwindcss": "^4.3.3"
  }
}
