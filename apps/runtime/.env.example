# Practice Manager Runtime Environment Variables
# Copy this file to .env (or .env.local) and fill in the deployment's values.
#
# The runtime is the worker host: it exposes the queue/worker/health API the core calls
# through DOMAIN_BACKEND_URL, and (unless RUNTIME_WORKERS_DISABLED=true) polls the queues
# itself. A single-install deployment has no runtime service — apps/core runs the same
# workers inline instead, and does not need these variables.

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────

# PostgreSQL is the only supported engine. The queue tables are created on demand.
DATABASE_URL=postgresql://localhost:5432/practice_manager

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────

# Shared secret the core sends to the queue and status routes, as a bearer token or as
# `adminToken` in the request body. Must match the core's CORE_BACKEND_SECRET.
# Unset means "no authentication", which is only acceptable for local development.
CORE_BACKEND_SECRET=

# Bearer token for `/api/<queue>/worker/run`. Falls back to CORE_BACKEND_SECRET.
WORKER_RUN_TOKEN=

# ─────────────────────────────────────────────
# Worker selection
# ─────────────────────────────────────────────

# Only the literal `true` enables a worker; `1` is not accepted. A worker that is not
# enabled still answers its HTTP route — a trigger runs one cycle regardless.
REPORT_WORKER_ENABLED=false
ANALYSIS_WORKER_ENABLED=false
SCRIBE_WORKER_ENABLED=false
BILLING_WORKER_ENABLED=false
EMAIL_WORKER_ENABLED=false
# Follows EMAIL_WORKER_ENABLED unless set explicitly.
INBOUND_EMAIL_WORKER_ENABLED=false
EQUIPMENT_SOURCER_WORKER_ENABLED=false
QUOTE_WRITER_TRIGGER_ENABLED=false
SCHEDULING_REMINDER_WORKER_ENABLED=false
ANALYSIS_BACKFILL_TRIGGER_ENABLED=false
ENV_HEALTH_WORKER_ENABLED=false

# Keep the HTTP API but start no poll loops, for a deployment that drains the queues with
# `npm run jobs:once` (Cloud Run job, cron entry) instead of a long-lived process.
RUNTIME_WORKERS_DISABLED=false

# ─────────────────────────────────────────────
# Queue tuning (defaults shown)
# ─────────────────────────────────────────────

# REPORT_QUEUE_TABLE=patient_report_jobs
# ANALYSIS_QUEUE_TABLE=patient_analysis_jobs
# SCRIBE_QUEUE_TABLE=patient_transcript_scribe_jobs
# BILLING_QUEUE_TABLE=patient_billing_jobs
# EMAIL_QUEUE_TABLE=outbound_messages
# INBOUND_EMAIL_TABLE=inbound_messages
# PATIENT_REPORTS_TABLE=patient_reports
# REPORT_BATCH_SIZE=10
# REPORT_POLL_SECONDS=200
# ANALYSIS_BATCH_SIZE=10
# ANALYSIS_POLL_SECONDS=200
# SCRIBE_BATCH_SIZE=10
# SCRIBE_POLL_SECONDS=200
# EMAIL_BATCH_SIZE=10
# EMAIL_POLL_SECONDS=200

# Domain applied to an inbound email whose recipient cannot be matched to a practice.
INBOUND_DEFAULT_DOMAIN=default

# ─────────────────────────────────────────────
# Outbound email
# ─────────────────────────────────────────────

# EMAIL_PROVIDER=resend
# EMAIL_FROM=notifications@mail.example.com
# The address in EMAIL_FROM must belong to a domain verified with the provider.
# EMAIL_RESEND_API_KEY=
# RESEND_API_KEY=

# ─────────────────────────────────────────────
# Model vendors used by the workers
# ─────────────────────────────────────────────

# OPENAI_API_KEY=
# CLAUDE_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# ANALYSIS_WORKER_AI_MODEL=
# REPORT_WORKER_AI_MODEL=
