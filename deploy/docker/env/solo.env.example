# Copy to deploy/docker/env/solo.env before `docker compose up`.
# Every value below is required unless a default is shown in compose.yml.

# Database password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-this-password
# Signs admin sessions. Generate with: openssl rand -base64 32
JWT_SECRET=change-this-secret

# Optional
# POSTGRES_USER=practice
# POSTGRES_DB=practice_manager
# PM_PORT=3000
# OPENAI_API_KEY=
