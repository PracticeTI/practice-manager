# Dependencies
node_modules/

# Next.js build output
.next/
out/

# Environment files (the example is tracked)
.env
.env.local
.env.*.local
!.env.example

# Logs and OS files
*.log
.DS_Store

# Editor swap/backup files (Vim, and friends)
*.sw?
*~

# Test/coverage output
coverage/

# Private overlay: the per-clone ignore rules for copied files live in `.git/info/exclude`
# (written by `npm run private:sync`), so this public file never names a private domain.
# What remains here is the generated manifest, the overlay checkout, the generated bridge
# modules, and the generic asset/third-party paths that apply even without an overlay.
# `npm run private:guard` is the authority: it fails if a destination is not excluded.
.private-overlay.json
.private-overlay-src/
apps/core/src/private/
apps/core/src/lib/privateDomains.js
apps/core/src/lib/privateDomains.data.js
apps/core/src/lib/landings.json
apps/core/src/lib/fcaReviewToken.js
apps/core/src/components/privateLandings.jsx
apps/core/tailwind.private.cjs
apps/core/src/app/private-overlay-sources.css
apps/core/docs/licensing-trademark.md
# Public assets are overlay-supplied: the core ships only the unbranded default lockup.
apps/core/public/*
!apps/core/public/.gitkeep
!apps/core/public/branding/
apps/core/content/templates/allied-health/domains/*/
# TAC assessment instruments: third-party content the AGPL grant cannot cover (docs/licensing.md).
apps/core/content/templates/allied-health/OT/

# Local compose environment files (the example is tracked)
deploy/docker/env/*.env

# Desktop packaging output
deploy/desktop/.stage/
apps/desktop/release/
