{
  "name": "practice-manager",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0 <23 || >=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @practice-manager/core",
    "build": "npm run build --workspace @practice-manager/core",
    "start": "npm run start --workspace @practice-manager/core",
    "dev:runtime": "npm run dev --workspace @practice-manager/runtime",
    "build:runtime": "npm run build --workspace @practice-manager/runtime",
    "start:runtime": "npm run start --workspace @practice-manager/runtime",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "jobs:once": "npm run jobs:once --workspace @practice-manager/jobs",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^24.2.9"
  }
}
